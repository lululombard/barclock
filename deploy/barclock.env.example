# This is /etc/barclock.env, the secrets and the backend choice for barclock.service.
# The installer puts it in place as 0640 root:barclock, so keep it that way.

# Long-lived access token, from your Home Assistant profile then Security.
# With an empty token barclock still starts and tells you so on screen.
HA_TOKEN=

# Broker credentials, only needed if you want the panel to appear in Home Assistant
# as a light. Leave them empty for anonymous access, which is logged as a warning.
MQTT_USER=
MQTT_PASSWORD=

# These override the endpoints in /etc/barclock.toml, handy if you'd rather keep
# every address next to the token. HA_URL accepts https://host, which is rewritten
# to wss://host/api/websocket, or a full ws or wss URL.
#HA_URL=https://<homeassistant_host>
#MQTT_HOST=<broker_lan_ip>
#MQTT_PORT=1883

# The CPU renderer is the default and sits at under 17 MB of RSS. The GLES2 one works
# too, but mesa loads libLLVM into the process and it jumps to 95 MB, which is a
# lot on a 512 MB Pi.
SLINT_BACKEND=linuxkms-software
#SLINT_BACKEND=linuxkms-femtovg

# The panel is natively 480x1920 portrait, so the picture gets rotated to landscape.
# Use 270 if yours comes out upside down.
SLINT_KMS_ROTATION=90

# Set this to debug to see every Home Assistant frame and every MQTT message.
#RUST_LOG=debug
